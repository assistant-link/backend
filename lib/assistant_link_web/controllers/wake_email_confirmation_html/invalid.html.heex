<main class="flex min-h-screen items-center justify-center px-6">
  <div id="wake-email-invalid" class="max-w-md space-y-4 text-center">
    <h1 class="text-2xl font-semibold">This link does not work</h1>
    <p>
      It has expired, or the wake email was changed or removed since it was sent.
      Set the wake email again to get a new link.
    </p>
  </div>
</main>
